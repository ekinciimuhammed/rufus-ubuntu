<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Rufus</vendor>
  <vendor_url>https://rufus.ie</vendor_url>
  <icon_name>rufus</icon_name>
  <action id="ie.akeo.rufus.run">
    <description>Run Rufus</description>
    <description xml:lang="tr">Rufus'u çalıştır</description>
    <message>Rufus needs administrative privileges to create bootable drives</message>
    <message xml:lang="tr">Rufus'un önyüklenebilir sürücü oluşturmak için yönetici yetkilerine ihtiyacı var</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/rufus/rufus</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
